    era_rst_src [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.250, height=0.278, fontsize=9, label=<<b>s_rst_n</b>>, pos="610,458!"];
    era_note [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<sweeps 0 … h_res · v_res − 1>, pos="785,403!"];

    // ------------------------------------------------------------------
    // Port A select: standing mux (wide side = inputs, left edge at x=1005)
    // ------------------------------------------------------------------
    mux [shape=trapezium, orientation=270, style=filled, fillcolor="#ede9fe", color="#8b5cf6", penwidth=1.8, width=1.111, height=4.653, fontsize=10, label=<<b>MUX</b><br/>3 × 2:1<br/><font point-size="9">addr<br/>data<br/>we</font>>, pos="1045,632!"];
    mux_0 [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=10, fontcolor="#7c3aed", label=<<b>0</b>>, pos="1018,765!"];
    mux_1 [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=10, fontcolor="#7c3aed", label=<<b>1</b>>, pos="1018,500!"];
    a_in0 [shape=point, style=invis, width=0.01, height=0.01, label="", pos="1005,765!"];
    a_in1 [shape=point, style=invis, width=0.01, height=0.01, label="", pos="1005,500!"];
    a_sel [shape=point, style=invis, width=0.01, height=0.01, label="", pos="1045,440!"];
    l_sty [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<s_stylus_*>, pos="948,775!"];
    l_era [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<s_eraser_*>, pos="948,510!"];
    l_sel [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#7c3aed", label=<sel · s_erasing>, pos="968,450!"];

