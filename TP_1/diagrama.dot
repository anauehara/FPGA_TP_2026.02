// =====================================================================
//  telecran — block diagram (macro level: write path, memory, HDMI timing)
//  Language: Graphviz DOT (fixed positions, layout = neato)
//  View/edit: https://dreampuf.github.io/GraphvizOnline  or  https://edotor.net
//
//  Every node has a fixed position (pos="x,y!", in points), so every wire
//  is a straight horizontal line or a clean 90° corner.
//  Yellow hexagons are named signals (s_clk_27, s_rst_n, ...): a tag with
//  the same name means the same wire, so long wires are not drawn.
// =====================================================================
digraph telecran {
    layout=neato;
    inputscale=72;          // pos values are in points
    splines=line;
    overlap=true;
    outputorder=nodesfirst; // wires are drawn on top of the blocks
    bgcolor="white";
    node [fontname="Helvetica", fixedsize=true];
    edge [fontname="Helvetica", color="#475569", arrowsize=0.7, penwidth=1.3];

    // ------------------------------------------------------------------
    // Groups (backgrounds)
    // ------------------------------------------------------------------
    g_pins [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#cbd5e1", penwidth=1.2, label="", width=2.083, height=8.333, pos="90,770!"];
    g_pins_t [shape=plaintext, width=1.806, height=0.25, label=<<table border="0" cellpadding="0" cellspacing="0" width="130"><tr><td align="left"><font point-size="12"><b>Board pins</b></font></td></tr></table>>, pos="90,1056!"];
    g_top [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#334155", penwidth=1.2, label="", width=27.917, height=15.347, pos="1195,568!", penwidth=1.8];
    g_top_t [shape=plaintext, width=27.639, height=0.25, label=<<table border="0" cellpadding="0" cellspacing="0" width="1990"><tr><td align="left"><font point-size="14"><b>telecran</b></font></td></tr></table>>, pos="1195,1106!"];
    g_top_sub [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<h_res = 720 · v_res = 480>, pos="320,1105!"];
    g_clk [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#cbd5e1", penwidth=1.2, label="", width=9.722, height=2.153, pos="555,1008!"];
    g_clk_t [shape=plaintext, width=9.444, height=0.25, label=<<table border="0" cellpadding="0" cellspacing="0" width="680"><tr><td align="left"><font point-size="12"><b>Clock &amp; reset</b></font></td></tr></table>>, pos="555,1071!"];
    g_enc [shape=box, style="rounded,filled", fillcolor="#fef2f2", color="#fca5a5", penwidth=1.2, label="", width=4.861, height=4.583, pos="380,750!"];
    g_enc_t [shape=plaintext, width=4.583, height=0.25, label=<<table border="0" cellpadding="0" cellspacing="0" width="330"><tr><td align="left"><font point-size="12"><b>Encoders</b></font></td></tr></table>>, pos="380,901!"];
    g_wr [shape=box, style="rounded,filled", fillcolor="#fff7ed", color="#fdba74", penwidth=1.2, label="", width=4.722, height=7.500, pos="735,645!"];
    g_wr_t [shape=plaintext, width=4.444, height=0.25, label=<<table border="0" cellpadding="0" cellspacing="0" width="320"><tr><td align="left"><font point-size="12"><b>Memory write</b></font></td></tr></table>>, pos="735,901!"];
    g_mux [shape=box, style="rounded,filled", fillcolor="#f5f3ff", color="#c4b5fd", penwidth=1.2, label="", width=6.597, height=7.500, pos="1158,645!"];
    g_mux_t [shape=plaintext, width=6.319, height=0.25, label=<<table border="0" cellpadding="0" cellspacing="0" width="455"><tr><td align="left"><font point-size="12"><b>Port A select &amp; register</b></font></td></tr></table>>, pos="1158,901!"];
    g_mem [shape=box, style="rounded,filled", fillcolor="#f0fdf4", color="#86efac", penwidth=1.2, label="", width=6.736, height=5.069, pos="1642,588!"];
    g_mem_t [shape=plaintext, width=6.458, height=0.25, label=<<table border="0" cellpadding="0" cellspacing="0" width="465"><tr><td align="left"><font point-size="12"><b>Memory</b></font></td></tr></table>>, pos="1642,756!"];

    // ------------------------------------------------------------------
    // Board pins
    // ------------------------------------------------------------------
    pin_clk [shape=cds, style=filled, fillcolor="#e2e8f0", color="#94a3b8", width=1.806, height=0.306, fontsize=10, label="i_clk_50", pos="90,1020!"];
    pin_rst [shape=cds, style=filled, fillcolor="#e2e8f0", color="#94a3b8", width=1.806, height=0.306, fontsize=10, label="i_rst_n (KEY0)", pos="90,985!"];
    pin_lca [shape=cds, style=filled, fillcolor="#e2e8f0", color="#94a3b8", width=1.806, height=0.306, fontsize=10, label="i_left_ch_a", pos="90,855!"];
    pin_lcb [shape=cds, style=filled, fillcolor="#e2e8f0", color="#94a3b8", width=1.806, height=0.306, fontsize=10, label="i_left_ch_b", pos="90,829!"];
    pin_rca [shape=cds, style=filled, fillcolor="#e2e8f0", color="#94a3b8", width=1.806, height=0.306, fontsize=10, label="i_right_ch_a", pos="90,700!"];
    pin_rcb [shape=cds, style=filled, fillcolor="#e2e8f0", color="#94a3b8", width=1.806, height=0.306, fontsize=10, label="i_right_ch_b", pos="90,674!"];
    pin_lpb [shape=cds, style=filled, fillcolor="#e2e8f0", color="#94a3b8", width=1.806, height=0.306, fontsize=10, label="i_left_pb (active low)", pos="90,510!"];

    // ------------------------------------------------------------------
    // Clock & reset
    // ------------------------------------------------------------------
    pll0 [shape=box, style="filled", fillcolor="#dbeafe", color="#3b82f6", penwidth=2, label="", width=2.778, height=1.639, pos="440,1001!"];
    pll0_t [shape=plaintext, width=2.556, height=0.22, label=<<table border="0" cellpadding="0" cellspacing="0" width="184"><tr><td align="left"><font point-size="11"><b>pll0</b> : pll</font></td></tr></table>>, pos="440,1047!"];
    pll_refclk [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<refclk>, pos="388,1020!"];
    pll_rst [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<rst>, pos="388,985!"];
    pll_clk27 [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<outclk_0>, pos="492,1020!"];
    pll_locked [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<locked>, pos="492,985!"];
    pll_note [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<50 MHz → 27 MHz>, pos="440,954!"];
    net_clk [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.389, height=0.278, fontsize=9, label=<<b>s_clk_27</b>>, pos="680,1020!"];
    net_rst [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.389, height=0.278, fontsize=9, label=<<b>s_rst_n</b>>, pos="680,985!"];
    l_not [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<not>, pos="250,994!"];

    // ------------------------------------------------------------------
    // Encoders
    // ------------------------------------------------------------------
    enc_x [shape=box, style="filled", fillcolor="#fee2e2", color="#dc2626", penwidth=2, label="", width=2.778, height=1.875, pos="440,828!"];
    enc_x_t [shape=plaintext, width=2.556, height=0.22, label=<<table border="0" cellpadding="0" cellspacing="0" width="184"><tr><td align="left"><font point-size="11"><b>enc_x</b> : encoder</font></td></tr></table>>, pos="440,882!"];
    encx_a [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_a>, pos="388,855!"];
    encx_b [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_b>, pos="388,829!"];
    encx_pos [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<o_position>, pos="492,842!"];
    encx_clk [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_clk>, pos="388,803!"];
    encx_rst [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_rst_n>, pos="388,777!"];
    encx_clk_src [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.250, height=0.278, fontsize=9, label=<<b>s_clk_27</b>>, pos="270,803!"];
    encx_rst_src [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.250, height=0.278, fontsize=9, label=<<b>s_rst_n</b>>, pos="270,777!"];
    enc_y [shape=box, style="filled", fillcolor="#fee2e2", color="#dc2626", penwidth=2, label="", width=2.778, height=1.875, pos="440,672!"];
    enc_y_t [shape=plaintext, width=2.556, height=0.22, label=<<table border="0" cellpadding="0" cellspacing="0" width="184"><tr><td align="left"><font point-size="11"><b>enc_y</b> : encoder</font></td></tr></table>>, pos="440,727!"];
    ency_a [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_a>, pos="388,700!"];
    ency_b [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_b>, pos="388,674!"];
    ency_pos [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<o_position>, pos="492,687!"];
    ency_clk [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_clk>, pos="388,648!"];
    ency_rst [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_rst_n>, pos="388,622!"];
    ency_clk_src [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.250, height=0.278, fontsize=9, label=<<b>s_clk_27</b>>, pos="270,648!"];
    ency_rst_src [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.250, height=0.278, fontsize=9, label=<<b>s_rst_n</b>>, pos="270,622!"];

    // ------------------------------------------------------------------
