    // ------------------------------------------------------------------
    stylus0 [shape=box, style="filled", fillcolor="#ffedd5", color="#f97316", penwidth=2, label="", width=2.917, height=4.306, pos="785,740!"];
    stylus0_t [shape=plaintext, width=2.694, height=0.22, label=<<table border="0" cellpadding="0" cellspacing="0" width="194"><tr><td align="left"><font point-size="11"><b>stylus0</b> : stylus</font></td></tr></table>>, pos="785,882!"];
    sty_note [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<addr = y · h_res + x>, pos="785,868!"];
    sty_x [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_x>, pos="728,842!"];
    sty_y [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_y>, pos="728,687!"];
    sty_bus [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.667, label=<o_addr<br/>o_data<br/>o_we>, pos="842,765!"];
    sty_clk [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_clk>, pos="728,635!"];
    sty_rst [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_rst_n>, pos="728,609!"];
    sty_clk_src [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.250, height=0.278, fontsize=9, label=<<b>s_clk_27</b>>, pos="610,635!"];
    sty_rst_src [shape=hexagon, style=filled, fillcolor="#fef9c3", color="#eab308", width=1.250, height=0.278, fontsize=9, label=<<b>s_rst_n</b>>, pos="610,609!"];
    l_posx [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<s_pos_x>, pos="610,852!"];
    l_posy [shape=plaintext, fixedsize=false, width=0.1, height=0.1, fontsize=9, fontcolor="#475569", label=<s_pos_y>, pos="610,697!"];
    eraser0 [shape=box, style="filled", fillcolor="#ffedd5", color="#f97316", penwidth=2, label="", width=2.917, height=2.222, pos="785,470!"];
    eraser0_t [shape=plaintext, width=2.694, height=0.22, label=<<table border="0" cellpadding="0" cellspacing="0" width="194"><tr><td align="left"><font point-size="11"><b>eraser0</b> : eraser</font></td></tr></table>>, pos="785,537!"];
    era_start [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_start>, pos="728,510!"];
    era_bus [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.667, label=<o_addr<br/>o_data<br/>o_we>, pos="842,500!"];
    era_busy [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<o_busy>, pos="842,440!"];
