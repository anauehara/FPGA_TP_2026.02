    wreg_out [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.667, label=<o_addr<br/>o_data<br/>o_we>, pos="1342,633!"];
    wreg_clk [shape=box, style=filled, fillcolor="#ffffff", color="#94a3b8", fixedsize=true, fontsize=10, width=1.056, height=0.278, label=<i_clk>, pos="1278,583!"];
